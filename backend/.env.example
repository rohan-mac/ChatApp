# ============================================================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# ============================================================================
# DO NOT commit .env to version control (use this file as reference instead)
# Copy this file to .env and fill in actual values

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ============================================================================
# PRODUCTION SETTINGS (Uncomment and modify for production)
# ============================================================================
# NODE_ENV=production
# PORT=10000
# MONGO_URI=mongodb+srv://prod-username:prod-password@prod-cluster.mongodb.net/database

# ============================================================================
# SECURITY - REQUIRED (Change these!)
# ============================================================================
# Use strong random strings for these secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ============================================================================
# CORS CONFIGURATION - Frontend Origins
# ============================================================================
# Development (add your development URLs)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Production (set your production frontend URL)
# CLIENT_URL=https://your-frontend.com
# CLIENT_URLS=https://your-frontend.com,https://www.your-frontend.com

# ============================================================================
# CLOUDINARY - REQUIRED FOR FILE UPLOADS
# ============================================================================
# Get credentials from: https://cloudinary.com/console/
#
# Steps to setup:
# 1. Sign up for free account at https://cloudinary.com/
# 2. Go to Settings (gear icon) in Cloudinary dashboard
# 3. Copy your credentials below:
#
# CLOUDINARY_CLOUD_NAME: Found in Settings -> Account section (top)
# CLOUDINARY_API_KEY: Found in Settings -> Account section
# CLOUDINARY_API_SECRET: Found in Settings -> Account section (Keep this private!)
#
# ⚠️  IMPORTANT: Never commit API_SECRET to version control
# ⚠️  IMPORTANT: All three values are REQUIRED - system will fail without them

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret-keep-private

# Cloudinary Upload Limits (in bytes)
# Avatars: 5MB (5242880 bytes) - images only (JPEG, PNG, GIF, WebP)
# Attachments: 20MB (20971520 bytes) - images, videos, documents
# These are set in uploadMiddleware.js

# ============================================================================
# PUSH NOTIFICATIONS - Firebase (Optional)
# ============================================================================
# Get credentials from: https://firebase.google.com/
# Optional - only needed if implementing push notifications
FCM_SERVER_KEY=your-firebase-server-key-optional

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
JSON_LIMIT=5mb
TRUST_PROXY=0

# ============================================================================
# LOGGING
# ============================================================================
# Set to 'debug' for detailed logs, 'info' for standard, 'warn' for errors only
LOG_LEVEL=debug
