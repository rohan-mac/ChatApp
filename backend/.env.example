NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=change-this-access-secret-must-be-16-chars-min
JWT_REFRESH_SECRET=change-this-refresh-secret-must-be-16-chars-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ============================================================================
# CORS Configuration - Allowed Frontend Origins
# ============================================================================
# For development (local):
# CLIENT_URL=http://localhost:5173
# CLIENT_URLS=http://localhost:5173,http://localhost:5174

# For production (Render backend + Vercel frontend):
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,https://chat-app-tau-ivory.vercel.app

REDIS_URL=redis://127.0.0.1:6379
JSON_LIMIT=5mb
TRUST_PROXY=0

# ============================================================================
# Media Service (Cloudinary)
# ============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# Notifications (Firebase Cloud Messaging)
# ============================================================================
FCM_SERVER_KEY=
